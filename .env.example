# 复制为 .env 后填写真实密钥；不要提交 .env。
PUPPY_AI_PROVIDER=siliconflow
PUPPY_AI_API_KEY=replace-with-your-provider-key
PUPPY_AI_BASE_URL=https://api.siliconflow.cn/v1
PUPPY_AI_MODEL=Pro/zai-org/GLM-5.1
PUPPY_AI_API_STYLE=chat_completions
PUPPY_AI_REQUEST_TIMEOUT_SECONDS=60
PUPPY_AI_MAX_OUTPUT_TOKENS=300

# 硅基流动模型目录
# 以下 91 个模型 ID 来自 2026-08-02 使用 `python app.py models` 的真实返回。
# Provider 会动态调整目录；请以当前命令输出为准。
# 目录同时包含文本、向量、重排、图像、音频、视频和 OCR 模型；
# PUPPY_AI_MODEL 必须选择支持 Chat Completions 的文本生成模型。
